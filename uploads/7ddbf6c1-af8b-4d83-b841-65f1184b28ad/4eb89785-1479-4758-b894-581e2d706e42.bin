<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<title>Sistema de Produção e Venda</title>
<style>
body { font-family: Arial; background:#f4f4f4; padding:20px }
h1 { margin-bottom:20px }
h2 { margin-top:20px }
.card { background:#fff; padding:15px; border-radius:8px; margin-bottom:20px }
button { padding:8px 12px; margin-top:10px; cursor:pointer }
input { padding:6px; width:120px }
table { width:100%; border-collapse:collapse; margin-top:10px }
th, td { border:1px solid #ccc; padding:8px; text-align:center }
</style>
</head>
<body>

<h1>🏭 Sistema de Produção e Venda</h1>

<!-- ESTOQUE MATÉRIA-PRIMA -->
<div class="card">
<h2>📦 Estoque Matéria-Prima (KG)</h2>

Alumínio (kg):
<input id="aluKg" type="number" step="0.01">

Papel Seda (kg):
<input id="sedaKg" type="number" step="0.01">

<br>
<button onclick="addMateria()">Adicionar ao estoque</button>

<p id="estoqueMateria"></p>
</div>

<!-- PRODUÇÃO -->
<div class="card">
<h2>🏭 Produção</h2>
<button onclick="produzir()">Produzir máximo possível</button>
<p id="resultadoProducao"></p>
</div>

<!-- ESTOQUE PRODUTO FINAL -->
<div class="card">
<h2>📦 Estoque Produto Final</h2>
<p id="estoqueProduto"></p>
</div>

<!-- VENDA -->
<div class="card">
<h2>🛒 Venda</h2>
Quantidade para vender:
<input id="vendaQtd" type="number">
<br>
<button onclick="vender()">Vender</button>
<p id="resultadoVenda"></p>
</div>

<!-- RELATÓRIOS -->
<div class="card">
<h2>📊 Relatório de Produção</h2>
<table id="relatorioProducao">
<tr>
<th>Qtd Produzida</th>
<th>Alumínio (kg)</th>
<th>Seda (kg)</th>
</tr>
</table>
</div>

<div class="card">
<h2>📊 Relatório de Vendas</h2>
<table id="relatorioVenda">
<tr>
<th>Qtd Vendida</th>
</tr>
</table>
</div>

<script>
// Estoques internos EM GRAMAS
let estoqueAlu = 0
let estoqueSeda = 0

// Estoque produto final EM UNIDADES
let estoqueProduto = 0

function atualizarTela() {
  document.getElementById("estoqueMateria").innerHTML =
    `Alumínio: ${(estoqueAlu / 1000).toFixed(2)} kg | 
     Seda: ${(estoqueSeda / 1000).toFixed(2)} kg`

  document.getElementById("estoqueProduto").innerHTML =
    `Produto final disponível: ${estoqueProduto} unidades`
}

function addMateria() {
  let alu = Number(document.getElementById("aluKg").value) || 0
  let seda = Number(document.getElementById("sedaKg").value) || 0

  estoqueAlu += alu * 1000
  estoqueSeda += seda * 1000

  atualizarTela()
}

function produzir() {
  let unidadesAlu = Math.floor(estoqueAlu / 200)
  let unidadesSeda = Math.floor(estoqueSeda / 30)
  let produzir = Math.min(unidadesAlu, unidadesSeda)

  if (produzir <= 0) {
    resultadoProducao.innerText = "❌ Estoque insuficiente para produção"
    return
  }

  estoqueAlu -= produzir * 200
  estoqueSeda -= produzir * 30
  estoqueProduto += produzir

  document.getElementById("relatorioProducao").innerHTML += `
    <tr>
      <td>${produzir}</td>
      <td>${(produzir * 200 / 1000).toFixed(2)}</td>
      <td>${(produzir * 30 / 1000).toFixed(2)}</td>
    </tr>
  `

  resultadoProducao.innerText = `✅ Produzido: ${produzir} unidades`
  atualizarTela()
}

function vender() {
  let qtd = Number(document.getElementById("vendaQtd").value)

  if (qtd <= 0 || qtd > estoqueProduto) {
    resultadoVenda.innerText = "❌ Estoque insuficiente para venda"
    return
  }

  estoqueProduto -= qtd

  document.getElementById("relatorioVenda").innerHTML += `
    <tr><td>${qtd}</td></tr>
  `

  resultadoVenda.innerText = "✅ Venda realizada com sucesso"
  atualizarTela()
}

atualizarTela()
</script>

</body>
</html>
