# WhatsApp Gateway Configuration

# Port for the gateway service
PORT=3001

# PostgreSQL connection string (shared with main app)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Webhook URL for sending events to the main Replit app
WEBHOOK_URL=https://your-replit-app.repl.co/api/gateway-webhook

# Shared secret for HMAC authentication between services
GATEWAY_SECRET=your-secure-random-string-here

# Session storage directory (use Railway volume mount)
SESSION_DIR=/app/whatsapp-sessions

# CORS origin (your Replit app URL)
CORS_ORIGIN=https://your-replit-app.repl.co
